// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum pokemonType {
  Normal
  Grass
  Fire
  Water
  Electric
  Ice
  Fighting
  Ground
  Poison
  Flying
  Psychic
  Bug
  Rock
  Ghost
  Dragon
  Dark
  Steel
  Fairy

  @@map("pokemontype")
}

enum Rarity{
  Common
  Rare
  Legendary

  @@map("pokemonrarity")
}

model Pokemon {
  id        Int   @id
  name      String
  type1     pokemonType
  type2     pokemonType?
  rarity    Rarity
  level     Int
  attack    Int
  defense   Int
  hp        Int
  nickname  String?
  trainerId String? @db.Uuid

  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)

  @@map("pokemons")
}

model Trainer {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  city      String
  createdAt DateTime @default(now()) @map("created_at")

  pokemons Pokemon[]
  captures Capture[]
  @@map("trainers")
}

model Capture {
  id               String   @id @default(uuid()) @db.Uuid
  trainerId        String  @db.Uuid
  pokemonName      String
  spriteUrl        String
  base_experience  Int
  height           Int
  weight           Int

  trainer Trainer? @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@map("capture")
}
